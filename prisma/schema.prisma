// ==============================================================================
// colld - Sistema Contable Cloud Multi-Tenant y Bimoneda (SUNAT & PCGE)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS TRIBUTARIOS Y CONTABLES (Normativa SUNAT y PCGE)
// ------------------------------------------------------------------------------

enum TaxRegime {
  GENERAL           // Régimen General (RG)
  MYPE_TRIBUTARIO   // Régimen MYPE Tributario (RMT)
  ESPECIAL_RER      // Régimen Especial de Renta (RER)
  NUEVO_RUS         // Nuevo Régimen Único Simplificado (NRUS)
}

enum PeriodStatus {
  ABIERTO     // Permite registro y modificación de asientos
  CERRADO     // Período cerrado contable y tributariamente
  BLOQUEADO   // Período congelado temporalmente para auditoría / declaración SIRE
}

enum AccountLevel {
  ELEMENTO          // 1 dígito  (ej: 6)
  CUENTA            // 2 dígitos (ej: 63)
  SUBCUENTA         // 3 dígitos (ej: 631)
  DIVISIONARIA      // 4 dígitos (ej: 6311)
  SUBDIVISIONARIA   // 5+ dígitos (ej: 63111)
}

enum AccountNature {
  DEUDORA   // Activo (1, 2, 3), Gastos por Naturaleza (6), Costos/Gastos Función (9)
  ACREEDORA // Pasivo (4), Patrimonio (5), Ingresos (7)
}

enum AccountCurrency {
  PEN   // Exclusiva en Soles
  USD   // Exclusiva en Dólares
  BOTH  // Bimoneda indistinta
}

enum CurrencyCode {
  PEN   // Sol peruano
  USD   // Dólar estadounidense
}

enum ExchangeRateType {
  COMPRA    // TC Compra SUNAT / SBS
  VENTA     // TC Venta SUNAT / SBS
  ESPECIAL  // TC Acordado en contrato / bancario específico
}

enum DocumentType {
  OTROS_0                   // 0: Otros
  DNI_1                     // 1: Documento Nacional de Identidad
  CARNET_EXTRANJERIA_4      // 4: Carnet de Extranjería
  RUC_6                     // 6: Registro Único de Contribuyentes
  PASAPORTE_7               // 7: Pasaporte
  CEDULA_DIPLOMATICA_A      // A: Cédula Diplomática
}

enum SunatComprobanteType {
  FACTURA_01                     // 01: Factura
  RECIBO_HONORARIOS_02           // 02: Recibo por Honorarios
  BOLETA_03                      // 03: Boleta de Venta
  LIQUIDACION_COMPRA_04          // 04: Liquidación de Compra
  BOLETO_TRANSPORTE_AEREO_05     // 05: Boleto de transporte aéreo
  CARTA_PORTE_AEREO_06           // 06: Carta de porte aéreo
  NOTA_CREDITO_07                // 07: Nota de Crédito
  NOTA_DEBITO_08                 // 08: Nota de Débito
  GUIA_REMISION_REMITENTE_09     // 09: Guía de Remisión Remitente
  TICKET_MAQUINA_REGISTRADORA_12 // 12: Ticket de máquina registradora
  DOCUMENTO_BANCOS_13            // 13: Documentos emitidos por bancos y AFP
  SERVICIOS_PUBLICOS_14          // 14: Recibo por servicios públicos (Luz, Agua, Teléfono)
  BOLETO_TRANSPORTE_16           // 16: Boleto de viaje y transporte público
  COMPROBANTE_RETENCION_20       // 20: Comprobante de Retención
  COMPROBANTE_PERCEPCION_21       // 21: Comprobante de Percepción
  GUIA_REMISION_TRANSPORTISTA_31 // 31: Guía de remisión del transportista
  DECLARACION_ADUANERA_50        // 50: Declaración Aduanera de Mercancías (DAM / DUA)
  OTROS_99                       // 99: Otros documentos autorizados
}

enum VoucherStatus {
  BORRADOR    // En elaboración, descuadrado permitido temporalmente
  REGISTRADO  // Firme, balanceado estrictamente Debe = Haber
  ANULADO     // Sin efecto contable pero conserva correlativo e historial de auditoría
}

// ------------------------------------------------------------------------------
// MODELO DE USUARIOS (MULTI-TENANT AUTH)
// ------------------------------------------------------------------------------

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("ADMIN") // ADMIN, CONTADOR, ASISTENTE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  companies Company[]

  @@map("users")
}

// ------------------------------------------------------------------------------
// EMPRESA MULTI-TENANT (RUC 11 DÍGITOS)
// ------------------------------------------------------------------------------

model Company {
  id              String       @id @default(cuid())
  ruc             String       @unique @db.VarChar(11) // RUC peruano validado con Módulo 11
  businessName    String       @db.VarChar(255)        // Razón Social según Ficha RUC SUNAT
  commercialName  String?      @db.VarChar(255)        // Nombre Comercial
  tradeName       String?      @db.VarChar(255)        // Nombre Comercial (compatibilidad)
  address         String?      @db.VarChar(300)        // Domicilio Fiscal
  legalAddress    String?      @db.VarChar(300)        // Domicilio Fiscal (compatibilidad)
  taxRegime       TaxRegime    @default(MYPE_TRIBUTARIO)
  currency        CurrencyCode @default(PEN)
  userId          String?
  
  // Indicadores de control fiscal SUNAT
  isSireObligated Boolean      @default(true)
  isRetentionAgent Boolean     @default(false)
  isPerceptionAgent Boolean    @default(false)
  isDetractionSubject Boolean  @default(true)
  detractionAccount String?    @db.VarChar(20)
  
  phone           String?      @db.VarChar(30)
  email           String?      @db.VarChar(100)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountPlans    AccountPlan[]
  transactions    Transaction[]

  // Compatibilidad con motor previo
  fiscalPeriods   FiscalPeriod[]
  accounts        Account[]
  entities        Entity[]
  costCenters     CostCenter[]
  subdiarios      Subdiario[]
  vouchers        Voucher[]

  @@index([ruc])
  @@index([userId])
  @@map("companies")
}

// ------------------------------------------------------------------------------
// PLAN CONTABLE SIMPLIFICADO Y JERÁRQUICO (PCGE)
// ------------------------------------------------------------------------------

model AccountPlan {
  id          String   @id @default(cuid())
  code        String   @db.VarChar(15) // ej. '101', '1212', '40111', '6011', '70111'
  name        String   @db.VarChar(200)
  level       Int      @default(1) // 1 a 5
  nature      String   @default("DEUDORA") // DEUDORA o ACREEDORA
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, code])
  @@map("account_plans")
}

// ------------------------------------------------------------------------------
// TRANSACCIONES Y ASIENTOS (colld TRANSACTION ENGINE)
// ------------------------------------------------------------------------------

model Transaction {
  id            String              @id @default(cuid())
  companyId     String
  voucherNumber String              @db.VarChar(20)
  date          DateTime            @db.Date
  glosa         String              @db.VarChar(500)
  currency      CurrencyCode        @default(PEN)
  exchangeRate  Decimal             @default(1.0000) @db.Decimal(10, 4)
  status        String              @default("REGISTRADO") // REGISTRADO, ANULADO, BORRADOR
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  details       TransactionDetail[]

  @@unique([companyId, voucherNumber])
  @@index([companyId, date])
  @@map("transactions")
}

model TransactionDetail {
  id            String       @id @default(cuid())
  transactionId String
  accountCode   String       @db.VarChar(15)
  debit         Decimal      @default(0.00) @db.Decimal(14, 2)
  credit        Decimal      @default(0.00) @db.Decimal(14, 2)
  docType       String?      @db.VarChar(10) // 01 (Factura), 03 (Boleta), etc.
  docSeries     String?      @db.VarChar(10)
  docNumber     String?      @db.VarChar(20)
  partyRuc      String?      @db.VarChar(15)
  partyName     String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountCode])
  @@map("transaction_details")
}

// ------------------------------------------------------------------------------
// TABLA DE TIPOS DE CAMBIO HISTÓRICOS (SUNAT / SBS)
// ------------------------------------------------------------------------------

model ExchangeRate {
  id           String       @id @default(cuid())
  date         DateTime     @unique @db.Date
  currency     CurrencyCode @default(USD)
  buyRate      Decimal      @default(3.7500) @db.Decimal(10, 4)
  sellRate     Decimal      @default(3.7800) @db.Decimal(10, 4)
  purchaseRate Decimal?     @db.Decimal(10, 4)
  saleRate     Decimal?     @db.Decimal(10, 4)
  source       String       @default("SUNAT")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([date])
  @@map("exchange_rates")
}

// ------------------------------------------------------------------------------
// MODELOS PREVIOS COMPATIBLES (FISCAL PERIOD, ACCOUNT, ENTITY, VOUCHERS)
// ------------------------------------------------------------------------------

model FiscalPeriod {
  id            String       @id @default(cuid())
  companyId     String
  year          Int
  month         Int
  status        PeriodStatus @default(ABIERTO)
  closedAt      DateTime?
  closedBy      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers      Voucher[]

  @@unique([companyId, year, month])
  @@index([companyId, year])
  @@map("fiscal_periods")
}

model Account {
  id                      String          @id @default(cuid())
  companyId               String
  code                    String          @db.VarChar(15)
  name                    String          @db.VarChar(200)
  level                   AccountLevel
  nature                  AccountNature
  currency                AccountCurrency @default(BOTH)
  allowsMovement          Boolean         @default(false)
  requiresEntity          Boolean         @default(false)
  requiresCostCenter      Boolean         @default(false)
  requiresDocRef          Boolean         @default(false)
  hasAutomaticDestination Boolean         @default(false)
  destinationDebitAccountId  String?
  destinationCreditAccountId String?

  parentAccountId         String?
  parentAccount           Account?        @relation("PCGEHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  children                Account[]       @relation("PCGEHierarchy")

  destinationDebitAccount  Account?       @relation("AccountDebitDestiny", fields: [destinationDebitAccountId], references: [id], onDelete: Restrict)
  destinationCreditAccount Account?       @relation("AccountCreditDestiny", fields: [destinationCreditAccountId], references: [id], onDelete: Restrict)
  
  sourceDebitDestinations  Account[]      @relation("AccountDebitDestiny")
  sourceCreditDestinations Account[]      @relation("AccountCreditDestiny")

  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  company                 Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherItems            VoucherItem[]

  @@unique([companyId, code])
  @@index([companyId, allowsMovement])
  @@index([companyId, code])
  @@map("accounts")
}

model Entity {
  id              String       @id @default(cuid())
  companyId       String
  docType         DocumentType @default(RUC_6)
  docNumber       String       @db.VarChar(15)
  businessName    String       @db.VarChar(255)
  tradeName       String?      @db.VarChar(255)
  address         String?      @db.VarChar(300)
  sunatState      String       @default("ACTIVO")
  sunatCondition  String       @default("HABIDO")
  isGoodTaxpayer  Boolean      @default(false)
  isRetentionAgent Boolean     @default(false)
  isRelatedParty  Boolean      @default(false)
  bankAccountPEN  String?      @db.VarChar(34)
  bankAccountUSD  String?      @db.VarChar(34)
  detractionAccount String?    @db.VarChar(20)
  phone           String?      @db.VarChar(30)
  email           String?      @db.VarChar(100)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherItems    VoucherItem[]

  @@unique([companyId, docType, docNumber])
  @@index([companyId, docNumber])
  @@index([companyId, businessName])
  @@map("entities")
}

model CostCenter {
  id          String        @id @default(cuid())
  companyId   String
  code        String        @db.VarChar(20)
  name        String        @db.VarChar(150)
  description String?       @db.VarChar(255)
  parentId    String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherItems VoucherItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("cost_centers")
}

model Subdiario {
  id                 String    @id @default(cuid())
  companyId          String
  code               String    @db.VarChar(4)
  name               String    @db.VarChar(100)
  description        String?   @db.VarChar(255)
  currentCorrelative Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers           Voucher[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("subdiarios")
}

model Voucher {
  id                     String           @id @default(cuid())
  companyId              String
  periodId               String
  subdiarioId            String
  voucherNumber          String           @db.VarChar(10)
  date                   DateTime         @db.Date
  currency               CurrencyCode     @default(PEN)
  exchangeRate           Decimal          @db.Decimal(10, 4)
  exchangeRateType       ExchangeRateType @default(VENTA)
  glossary               String           @db.VarChar(500)
  status                 VoucherStatus    @default(REGISTRADO)

  totalDebitPEN          Decimal          @default(0.00) @db.Decimal(14, 2)
  totalCreditPEN         Decimal          @default(0.00) @db.Decimal(14, 2)
  totalDebitUSD          Decimal          @default(0.00) @db.Decimal(14, 2)
  totalCreditUSD         Decimal          @default(0.00) @db.Decimal(14, 2)
  
  isBalanced             Boolean          @default(true)
  hasAutomaticDestination Boolean         @default(false)
  originModule           String           @default("MANUAL")
  
  createdBy              String?          @db.VarChar(100)
  updatedBy              String?          @db.VarChar(100)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalPeriod           FiscalPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subdiario              Subdiario        @relation(fields: [subdiarioId], references: [id], onDelete: Restrict)
  items                  VoucherItem[]

  @@unique([companyId, periodId, subdiarioId, voucherNumber])
  @@index([companyId, date])
  @@index([companyId, periodId])
  @@index([companyId, subdiarioId])
  @@map("vouchers")
}

model VoucherItem {
  id                String                @id @default(cuid())
  voucherId         String
  lineNumber        Int
  accountId         String
  entityId          String?
  costCenterId      String?

  docType           SunatComprobanteType?
  docSeries         String?               @db.VarChar(10)
  docNumber         String?               @db.VarChar(20)
  docDate           DateTime?             @db.Date
  docDueDate        DateTime?             @db.Date

  glossary          String                @db.VarChar(500)

  debitPEN          Decimal               @default(0.00) @db.Decimal(14, 2)
  creditPEN         Decimal               @default(0.00) @db.Decimal(14, 2)
  debitUSD          Decimal               @default(0.00) @db.Decimal(14, 2)
  creditUSD         Decimal               @default(0.00) @db.Decimal(14, 2)

  isAutoDestination Boolean               @default(false)
  originalItemId    String?

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  voucher           Voucher               @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account           Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entity            Entity?               @relation(fields: [entityId], references: [id], onDelete: Restrict)
  costCenter        CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  
  originalItem      VoucherItem?          @relation("ItemDestinations", fields: [originalItemId], references: [id], onDelete: Cascade)
  generatedItems    VoucherItem[]         @relation("ItemDestinations")

  @@index([voucherId])
  @@index([accountId])
  @@index([entityId])
  @@index([costCenterId])
  @@index([docType, docSeries, docNumber])
  @@map("voucher_items")
}
